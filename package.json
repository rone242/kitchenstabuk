{
  "name": "kitchenstabuk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:format": "pnpm --filter database db:format",
    "db:validate": "pnpm --filter database db:validate",
    "db:generate": "pnpm --filter database db:generate",
    "db:migrate": "pnpm --filter database db:migrate",
    "db:migrate:deploy": "pnpm --filter database db:migrate:deploy",
    "db:seed": "pnpm --filter database db:seed",
    "db:verify": "pnpm --filter database db:verify"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
